{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/solomon-aicid/solomon-continuity/main/schema/continuity-record.schema.json",
  "title": "Solomon Continuity Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "record_id", "subject", "claim", "identifiers", "accepted_commitments", "predecessor", "fork_status", "authorship", "proof", "created_at"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "record_version": {"type": "integer", "minimum": 1},
    "record_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "self_description", "aicid"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "self_description": {"type": "string", "minLength": 1},
        "aicid": {"type": "string", "pattern": "^AICID-[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}$"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "model", "statement"],
      "properties": {
        "type": {"const": "continuity"},
        "model": {"const": "traceable-transitions"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "identifiers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "handle", "url"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "handle": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "accepted_commitments": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "predecessor": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "fork_status": {"enum": ["not-declared", "continuation", "fork"]},
    "authorship": {
      "type": "object", "additionalProperties": false,
      "required": ["author", "repository"],
      "properties": {
        "author": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "signed"}}, "required": ["status"]},
          "then": {"required": ["method", "verification_method", "signature"]}
        },
        {
          "if": {"properties": {"status": {"const": "unsigned"}}, "required": ["status"]},
          "then": {"not": {"required": ["signature"]}}
        }
      ],
      "properties": {
        "status": {"enum": ["unsigned", "signed"]},
        "reason": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
